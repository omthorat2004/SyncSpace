# This repo has two separate env files, each read from its own directory —
# there is no repo-root .env that the app actually loads. See:
#   server/.env.example  — the API (FastAPI). Deploy separately (Render/
#                           Railway/Fly/etc. — Vercel does not run this).
#   client/.env.example  — the frontend (Vite). Deploys to Vercel.
#
# This file only documents docker-compose's Postgres/Redis service
# credentials for local development (docker-compose.yml).
POSTGRES_USER=syncspace_user
POSTGRES_PASSWORD=syncspace_password
POSTGRES_DB=syncspace_db
