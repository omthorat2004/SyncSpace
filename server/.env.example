# Copy to .env and fill in. This file is read from the server/ directory
# (see BASE_DIR in src/server/core/_settings.py), not the repo root.

# Postgres connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/syncspace

# Comma-separated list of frontend origins allowed to call this API.
# In production this must include your deployed frontend's exact origin
# (e.g. https://your-app.vercel.app) or the browser will block every request.
ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Any long random string
SECRET_KEY=change-me-to-a-long-random-string

# Redis (required — used for content caching, see core/redis_client.py)
REDISCLOUD_URL=redis://localhost:6379/0

ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAY=7

# Set to "production" when deploying — this switches auth cookies to
# Secure + SameSite=None, which is required for a frontend hosted on a
# different origin (e.g. Vercel) to receive them at all. Also requires
# the API itself to be served over HTTPS.
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
